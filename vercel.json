{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {"source": "/sobre{/}?", "destination": "/", "permanent": true},
    {"source": "/areas{/}?", "destination": "/", "permanent": true},
    {"source": "/diagnostico{/}?", "destination": "/contato/", "permanent": true},
    {"source": "/regularizacao-fundiaria{/}?", "destination": "/regularizacao-fundiaria-acre/", "permanent": true},
    {"source": "/agro{/}?", "destination": "/regularizacao-fundiaria-acre/", "permanent": true},
    {"source": "/blog/regularizar-propriedade-rural-acre{/}?", "destination": "/regularizacao-fundiaria-acre/", "permanent": true},
    {"source": "/blog/agro-regularizacao-ambiental{/}?", "destination": "/regularizacao-fundiaria-acre/", "permanent": true},
    {"source": "/aposentadoria-rural{/}?", "destination": "/aposentadoria-rural-acre/", "permanent": true},
    {"source": "/blog/aposentadoria-rural-prova{/}?", "destination": "/aposentadoria-rural-acre/", "permanent": true},
    {"source": "/blog/aposentadoria-rural-acre-segurado-especial{/}?", "destination": "/aposentadoria-rural-acre/", "permanent": true},
    {"source": "/bpc-loas{/}?", "destination": "/advogado-previdenciario-rio-branco/", "permanent": true},
    {"source": "/blog/bpc-loas-como-funciona{/}?", "destination": "/advogado-previdenciario-rio-branco/", "permanent": true},
    {"source": "/consignado-indevido{/}?", "destination": "/", "permanent": true},
    {"source": "/energisa{/}?", "destination": "/", "permanent": true},
    {"source": "/familia{/}?", "destination": "/", "permanent": true},
    {"source": "/criminal{/}?", "destination": "/", "permanent": true},
    {"source": "/ambiental-rural{/}?", "destination": "/", "permanent": true},
    {"source": "/blog{/}?", "destination": "/", "permanent": true},
    {"source": "/blog/:slug*", "destination": "/", "permanent": true},
    {"source": "/favicon.ico", "destination": "/assets/brand/favicon.png", "permanent": true}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "X-Frame-Options", "value": "SAMEORIGIN"}, {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"}]},
    {"source": "/assets/index-(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/assets/(brand|areas)/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400"}]}
  ]
}
